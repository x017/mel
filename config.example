# mel config - copy to ~/.config/mel/config
# theme = nord                # nord | catppuccin | tokyo-night (or your own in ~/.config/mel/themes/)

layout = minimal              # minimal | card | left | pill | avatar | band | terminal | corner | ring | reactor
accent_color = #7dd3fc        # ring / reactor colour
ring_radius = 150             # ring / reactor size
idle_fps = 30                 # rings keep turning at this fps when idle, 0 = only animate on input
mono_font = monospace         # terminal layout font
greeting = true               # "Good evening, Name"
blink_colon = true            # clock colon pulses every second
clock_size = 0                # 0 = automatic per layout
clock_bold = false            # default: bold only in card layout

background = blur             # blur | dim | image | solid | gradient
blur_strength = 12
blur_in = true                # desktop blurs in when locking
vignette = 0.35               # darkened edges, 0 = off
background_image = ~/Pictures/lock.png   # PNG only

dot_style = circle            # circle (animated) | char
success_color = #6ee7a8
caps_lock_color = #ff6b6b

font = Inter
fade_in_duration = 280        # entrance speed, ms
shake_intensity = 12
message =
on_unlock =

# card layout only
panel_width = 420
panel_height = 280
panel_radius = 18
panel_opacity = 0.82
